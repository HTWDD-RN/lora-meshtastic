+void RadioLibInterface::printBytesInfo(const char *label, const uint8_t *p, size_t numbytes)
+{
+    int labelSize = strlen(label);
+    char *messageBuffer = new char[(numbytes * 2) + 2];
+    //strncpy(messageBuffer, label, labelSize);
+    //snprintf(messageBuffer + labelSize, 9, " %03d %03d", lora.getSNR(), lround(lora.getRSSI()));
+    for (size_t i = 0; i < numbytes; i++)
+        snprintf(messageBuffer + i * 2, 4, "%02x", p[i]);
+    strcpy(messageBuffer + numbytes * 2, "\n");
+    //LOG_INFO(messageBuffer);
+    // the buffer size of the stream seems to limit how much data can actually be dumped
+    //console->Print::write(messageBuffer, sizeof(messageBuffer));
+    //console->flush();
+    consolePrintf("%s %d %d %s", label, getRSSI(), getSNR(), messageBuffer);
+    delete[] messageBuffer;
+}
